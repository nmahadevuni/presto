    <artifactId>presto-iceberg-function-namespace</artifactId>
    <description>Hive functions for Presto</description>
    <packaging>presto-plugin</packaging>

    <properties>
        <air.main.basedir>${project.parent.basedir}</air.main.basedir>
        <dep.iceberg.version>1.5.0</dep.iceberg.version>
    </properties>

    <dependencies>
        <dependency>
